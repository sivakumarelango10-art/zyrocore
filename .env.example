# ==================================================
# ZYRØCORE ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env or .env.local for local setup
# DO NOT COMMIT ACTUAL SECRET VALUES TO GIT
# ==================================================

# --------------------------------------------------
# PUBLIC CLIENT VARIABLES (Safe for Browser)
# --------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public payment & integration key IDs (Optional)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_site_verification

# --------------------------------------------------
# PRIVATE SERVER VARIABLES (Confidential — Server Only)
# --------------------------------------------------
# Postgres Connection URLs
DATABASE_URL="postgresql://postgres.your-project:your_password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.your-project:your_password@aws-0-region.pooler.supabase.com:5432/postgres"

# Supabase Server Auth & Secret Keys (@supabase/server)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Admin Authorization & JWT Signing
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=your_secure_initial_admin_password
JWT_SECRET=your_long_random_jwt_secret_token_here

# Payment Provider Secrets
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# AI & Storage Integrations
GEMINI_API_KEY=your_gemini_api_key_here
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token
